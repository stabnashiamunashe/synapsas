# Copy to .env (docker compose reads this name for both variable substitution and the app container) and edit.

# --- stack ---
# DOMAIN is only used by scripts/deploy-docker.sh for the final message
DOMAIN=approvals.zimstat.co.zw
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# --- app ---
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_NAME=ZimStat Approvals
APP_URL=https://approvals.zimstat.co.zw
CRON_SECRET=change-me-cron-secret


# --- Email (SMTP; works with Hostinger Mail, Google Workspace, SES, SendGrid, Postmark) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false            # true for port 465 (implicit TLS); STARTTLS is required on 587
MAIL_FROM="ZimStat Approvals <no-reply@zimstat.co.zw>"

# --- Security ---
REQUIRE_EMAIL_VERIFICATION=  # blank = on when SMTP_HOST is set; 0/1 to force
HIBP_CHECK=1                 # reject passwords found in known breaches (k-anonymity lookup)
TRUST_PROXY=1                # read client IP from X-Forwarded-For (set 0 if the app is exposed directly)
