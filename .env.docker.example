# Copy to .env (docker compose reads this name for both variable substitution and the app container) and edit.

# --- stack ---
# DOMAIN is only used by scripts/deploy-docker.sh for the final message
DOMAIN=approvals.zimstat.co.zw
# PostgreSQL credentials for the db container. Letters, digits, '.', '_' and '-' only: the password is placed inside the database URL.
DB_PASSWORD=change-me-db-password
# DB_USER=synapsas
# DB_NAME=approvals

# --- first administrator (created by scripts/deploy-docker.sh when it does not exist yet; must change the password at first sign-in) ---
ADMIN_EMAIL=ict.admin@zimstat.co.zw
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=                       # leave blank to have one generated and printed once by the deploy script

# --- app ---
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_NAME=ZimStat Approvals
APP_URL=https://approvals.zimstat.co.zw
CRON_SECRET=change-me-cron-secret


# --- Email (SMTP; works with Hostinger Mail, Google Workspace, SES, SendGrid, Postmark) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false            # true for port 465 (implicit TLS); STARTTLS is required on 587
MAIL_FROM="ZimStat Approvals <no-reply@zimstat.co.zw>"

# --- Security ---
REQUIRE_EMAIL_VERIFICATION=  # blank = on when SMTP_HOST is set; 0/1 to force
HIBP_CHECK=1                 # reject passwords found in known breaches (k-anonymity lookup)
TRUST_PROXY=1                # read client IP from X-Forwarded-For (set 0 if the app is exposed directly)

# --- WhatsApp Business Cloud API (optional; the system works without it) ---
WHATSAPP_ACCESS_TOKEN=           # permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=        # Phone number ID from WhatsApp > API Setup
WHATSAPP_APP_SECRET=             # App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_CASE_CREATED=case_received   # approved template names (see docs/WHATSAPP.md)
WHATSAPP_TEMPLATE_CASE_UPDATE=case_update
WHATSAPP_TEMPLATE_RELEASE=                     # release alert template; without it alerts only reach people active in the last 24 h
WHATSAPP_TEMPLATE_LANG=en
