DATABASE_URL="mysql://root:@localhost:3306/documentdb"
AUTH_SECRET="change-me-in-production-use-a-long-random-string"
NEXT_PUBLIC_APP_NAME="Synapsas"
UPLOAD_DIR="./uploads"
CRON_SECRET="dev-cron-secret"
APP_URL="http://localhost:3000"

# Billing
BILLING_PROVIDER="manual"   # manual | stripe | paynow
BILLING_CURRENCY="USD"
BILLING_BANK_DETAILS="Bank: Example Bank · Account: Synapsas (Pvt) Ltd · No: 000000000 · Branch: Harare"
PLATFORM_ADMIN_KEY="change-me-platform-admin-key"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""

# --- Email (SMTP; works with Hostinger Mail, Google Workspace, SES, SendGrid, Postmark) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false            # true for port 465 (implicit TLS); STARTTLS is required on 587
MAIL_FROM="Synapsas <no-reply@synapsas.tech>"

# --- Security ---
REQUIRE_EMAIL_VERIFICATION=  # blank = on when SMTP_HOST is set; 0/1 to force
HIBP_CHECK=1                 # reject passwords found in known breaches (k-anonymity lookup)
TRUST_PROXY=1                # read client IP from X-Forwarded-For (set 0 if the app is exposed directly)
